+// The frontend may recreate its swapchain with a different image count at any
+// time (RetroArch switches present mode FIFO -> MAILBOX when fast-forward
+// clears the swap interval, and MAILBOX requires one more image on several
+// WSI implementations). There is no callback into the core when this happens,
+// so get_sync_index() can return an index past the end of the arrays that were
+// sized once in init(). Grow them on demand; the assert() below is compiled
+// out in release builds and never caught this.
+static void ensure_sync_index_capacity(unsigned index)
+{
+	if (index >= retro_images.size())
+	{
+		retro_images.resize(index + 1);
+		retro_image_handles.resize(index + 1);
+	}
+}
